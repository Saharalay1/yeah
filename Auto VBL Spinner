                stopAll()
                running = false
                break
            end

            if startTime > 0 and (tick() - startTime) >= 15 then
                setToggle(false)
                pcall(function()
                    if failRemote then
                        failRemote:InvokeServer("MouseButton1", true, "Spike\xE2\x80\x8B\x8F")
                    end
