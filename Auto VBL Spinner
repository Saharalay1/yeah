local function getStyle()
    local char = workspace:FindFirstChild(lp.Name)
    if not char then return nil end
    local jb = char:FindFirstChild("JerseyBack")
    if not jb then return nil end
    local sn = jb:FindFirstChild("StyleName")
    if not sn then return nil end
    return sn.Text or sn.Value
end

local function stopAll()
    setToggle(false)
    if sg and sg.Parent then
        sg:Destroy()
    end
end

-- Fail path: force OFF → save → teleport same PlaceId → wait 3s → kick
local function doFail()
    setToggle(false)
    forceSave()

    pcall(function()
        if failRemote then
            failRemote:InvokeServer("MouseButton1", true, "Spike\xE2\x80\x8B\x8F")
        end
    end)

    -- Teleport to the same PlaceId (any server)
    pcall(function()
        TeleportService:Teleport(game.PlaceId)
    end)

    -- Give the teleport time to start before we force-kick
    task.wait(3)

    pcall(function()
        lp:Kick("FAILED — turn off Verified Teleports in your executor")
    end)

    if sg and sg.Parent then
        sg:Destroy()
    end
end

-- Check if any return value contains "You don't" (out of spins)
local function isOutOfSpins(result)
    if type(result) ~= "table" then return false end
    for i = 1, result.n or #result do
        local v = result[i]
        if type(v) == "string" and string.find(string.lower(v), "you don't", 1, true) then
            return true
        end
        if type(v) == "table" then
            for _, nested in pairs(v) do
                if type(nested) == "string" and string.find(string.lower(nested), "you don't", 1, true) then
                    return true
                end
            end
        end
    end
    return false
end

-- ==================== Main Loop ====================
local running = true

task.spawn(function()
    while running and sg and sg.Parent do
        if cfg.on then
            if not Event then
                Event, failRemote = getRemotes()
            end

            local cur = getStyle()
            if cur and string.lower(tostring(cur)) == string.lower(tostring(cfg.t)) then
                stopAll()
                running = false
                break
            end

            if startTime > 0 and (tick() - startTime) >= 15 then
                doFail()
                running = false
                break
            end

            if Event then
                local ok, result = pcall(function()
                    return table.pack(Event:InvokeServer(true))
                end)

                if ok and type(result) == "table" then
                    if isOutOfSpins(result) then
                        doFail()
                        running = false
                        break
                    end
                end
            end

            task.wait(0.08)
        else
            task.wait(0.15)
        end
    end
end)

