local function setToggle(state)
    cfg.on = (state == true)
    tog.Text = cfg.on and "ON" or "OFF"
    tog.BackgroundColor3 = cfg.on and Color3.fromRGB(45, 160, 95) or Color3.fromRGB(55, 55, 65)
    save()
end

-- Dragging
local dragging, dragStart, startPos
fr.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = fr.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

UIS.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        fr.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

fr.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
        cfg.x = fr.Position.X.Scale
        cfg.y = fr.Position.Y.Scale
        save()
    end
end)

tb:GetPropertyChangedSignal("Text"):Connect(function()
    cfg.t = tb.Text
    save()
end)

tb.FocusLost:Connect(function()
    cfg.t = tb.Text
    save()
end)

local startTime = 0
