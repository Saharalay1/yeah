-- Drag
local dragging, dragStart, startPos
fr.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = fr.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

UIS.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local d = input.Position - dragStart
        fr.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
    end
end)

fr.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
        cfg.x = fr.Position.X.Scale
        cfg.y = fr.Position.Y.Scale
        saveConfig()
    end
end)

tb:GetPropertyChangedSignal("Text"):Connect(function()
    cfg.t = tb.Text
    saveConfig()
end)

tb.FocusLost:Connect(function()
    cfg.t = tb.Text
    saveConfig()
end)

local startTime = 0
