-- ───────────────────────────── Logic ─────────────────────────────
local function setToggle(state)
    cfg.on = state == true
    tog.Text = cfg.on and "ON" or "OFF"
    tog.BackgroundColor3 = cfg.on and Color3.fromRGB(45, 160, 95) or Color3.fromRGB(55, 55, 65)
    save()                                      -- always save on any toggle change
end

-- Dragging
local dragging, dragStart, startPos
fr.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = fr.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

UIS.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
                  or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        fr.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

fr.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
        cfg.x = fr.Position.X.Scale
        cfg.y = fr.Position.Y.Scale
        save()
    end
end)

-- Text box → config
tb:GetPropertyChangedSignal("Text"):Connect(function()
    cfg.t = tb.Text
    save()
end)
tb.FocusLost:Connect(function()
    cfg.t = tb.Text
    save()
end)

local startTime = 0
if cfg.on then
    startTime = tick()
end

tog.MouseButton1Click:Connect(function()
    local newState = not cfg.on
    setToggle(newState)
    if newState then
        startTime = tick()
    else
        startTime = 0
    end
end)

local function getStyle()
    local char = workspace:FindFirstChild(lp.Name)
    if not char then return nil end
    local jb = char:FindFirstChild("JerseyBack")
    if not jb then return nil end
    local sn = jb:FindFirstChild("StyleName")
    if not sn then return nil end
    return sn.Text or sn.Value
end

local function stopAll()
    setToggle(false)
    if sg and sg.Parent then
        sg:Destroy()
    end
end

local running = true

task.spawn(function()
    while running and sg and sg.Parent do
        if cfg.on then
            local cur = getStyle()
            if cur and string.lower(tostring(cur)) == string.lower(tostring(cfg.t)) then
                -- success
                stopAll()
                running = false
                break
            end

            -- timeout fail-safe (15 s)
            if startTime > 0 and (tick() - startTime) >= 15 then
                setToggle(false)
                pcall(function()
                    failRemote:InvokeServer("MouseButton1", true, "Spike\xE2\x80\x8B\x8F")
                end)
                pcall(function()
                    TeleportService:Teleport(73956553001240)
                end)
                pcall(function()
                    lp:Kick("FAILED — turn off Verified Teleports in your executor")
                end)
                if sg and sg.Parent then sg:Destroy() end
                running = false
                break
            end

            pcall(function()
                Event:InvokeServer(true)
            end)
            task.wait(0.08)
        else
            task.wait(0.15)
        end
    end
end)

