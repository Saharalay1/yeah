--[[
    Style Roller - Working Version
    - Fails ONLY when remote returns "You don't" (out of spins) OR 15s timer
    - Teleports to the same PlaceId (any server)
    - task.wait(3) before Kick so the teleport actually starts
    - Config (ON/OFF) force-saved before every teleport
    - Full self-replicating queue_on_teleport
    - No blue line
]]

local Players           = game:GetService("Players")
local UIS               = game:GetService("UserInputService")
local Http              = game:GetService("HttpService")
local TeleportService   = game:GetService("TeleportService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local lp = Players.LocalPlayer

local FILE = "StyleRoller.json"

-- ==================== Config ====================
local cfg = {
    t  = "",
    on = false,
    x  = 0.5,
    y  = 0.5
}

local function loadConfig()
    local ok, raw = pcall(function()
        if isfile and isfile(FILE) then
            return readfile(FILE)
        end
        return nil
    end)
    if not ok or type(raw) ~= "string" or #raw < 3 then return end

    local success, data = pcall(function()
        return Http:JSONDecode(raw)
    end)
    if success and type(data) == "table" then
        cfg.t  = tostring(data.t or "")
        cfg.on = (data.on == true)
        cfg.x  = tonumber(data.x) or 0.5
        cfg.y  = tonumber(data.y) or 0.5
    end
end

local function saveConfig()
    pcall(function()
        writefile(FILE, Http:JSONEncode({
            t  = tostring(cfg.t or ""),
            on = (cfg.on == true),
            x  = tonumber(cfg.x) or 0.5,
            y  = tonumber(cfg.y) or 0.5
        }))
    end)
end

local function forceSave()
    saveConfig()
    task.wait(0.08)
end

loadConfig()

-- ==================== Remotes ====================
local function getRemotes()
    local ok, Event, failRemote = pcall(function()
        local packages = ReplicatedStorage:WaitForChild("Packages", 8)
        local index = packages:WaitForChild("_Index", 5)
        local knitPkg = index:WaitForChild("sleitnick_knit@1.7.0", 5)
        local knit = knitPkg:WaitForChild("knit", 5)
        local services = knit:WaitForChild("Services", 5)

        local styleRF = services:WaitForChild("StyleService", 5):WaitForChild("RF", 5)
        local settingsRF = services:WaitForChild("SettingsService", 5):WaitForChild("RF", 5)

        return styleRF:WaitForChild("Roll", 5), settingsRF:WaitForChild("UpdateKeybind", 5)
    end)
    if ok then
        return Event, failRemote
    end
    return nil, nil
end

