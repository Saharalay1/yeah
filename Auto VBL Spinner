                pcall(function()
                    lp:Kick("FAILED — turn off Verified Teleports in your executor")
                end)
                if sg and sg.Parent then sg:Destroy() end
                running = false
                break
            end

            pcall(function()
                Event:InvokeServer(true)
            end)
            task.wait(0.08)
        else
            task.wait(0.15)
        end
    end
end)

