local UIS               = game:GetService("UserInputService")
local Http              = game:GetService("HttpService")
local TeleportService   = game:GetService("TeleportService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local lp = Players.LocalPlayer

-- Remote paths (Knit)
local Event = ReplicatedStorage
    :WaitForChild("Packages")
    :WaitForChild("_Index")
    :WaitForChild("sleitnick_knit@1.7.0")
    :WaitForChild("knit")
    :WaitForChild("Services")
    :WaitForChild("StyleService")
    :WaitForChild("RF")
    :WaitForChild("Roll")

local failRemote = ReplicatedStorage
    :WaitForChild("Packages")
    :WaitForChild("_Index")
    :WaitForChild("sleitnick_knit@1.7.0")
    :WaitForChild("knit")
    :WaitForChild("Services")
    :WaitForChild("SettingsService")
    :WaitForChild("RF")
    :WaitForChild("UpdateKeybind")

local FILE = "StyleRoller.json"

-- Default config
local cfg = {
    t  = "",
    on = false,
    x  = 0.5,
    y  = 0.5
}

local function load()
    pcall(function()
        if isfile and isfile(FILE) then
            local raw = readfile(FILE)
            if type(raw) == "string" and #raw > 0 then
                local ok, data = pcall(Http.JSONDecode, Http, raw)
                if ok and type(data) == "table" then
                    cfg.t  = tostring(data.t or "")
                    cfg.on = data.on == true          -- strict boolean
                    cfg.x  = tonumber(data.x) or 0.5
                    cfg.y  = tonumber(data.y) or 0.5
                end
            end
        end
    end)
end

local function save()
    pcall(function()
        local payload = {
            t  = tostring(cfg.t or ""),
            on = cfg.on == true,           -- always pure boolean
            x  = tonumber(cfg.x) or 0.5,
            y  = tonumber(cfg.y) or 0.5
        }
        writefile(FILE, Http:JSONEncode(payload))
    end)
end

load()

-- Clean up any previous instance
pcall(function()
    local old = lp:FindFirstChild("PlayerGui") and lp.PlayerGui:FindFirstChild("StyleRoller")
    if old then old:Destroy() end
end)

