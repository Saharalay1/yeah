-- Wait for the remotes safely
local function getRemotes()
    local packages = ReplicatedStorage:WaitForChild("Packages", 10)
    if not packages then return nil, nil end
    local index = packages:WaitForChild("_Index", 5)
    if not index then return nil, nil end
    local knit = index:WaitForChild("sleitnick_knit@1.7.0", 5)
    if not knit then return nil, nil end
    local services = knit:WaitForChild("knit", 5):WaitForChild("Services", 5)
    if not services then return nil, nil end

    local styleService = services:WaitForChild("StyleService", 5)
    local settingsService = services:WaitForChild("SettingsService", 5)
    if not styleService or not settingsService then return nil, nil end

    local Event = styleService:WaitForChild("RF", 5):WaitForChild("Roll", 5)
    local failRemote = settingsService:WaitForChild("RF", 5):WaitForChild("UpdateKeybind", 5)
    return Event, failRemote
end

local Event, failRemote = getRemotes()
if not Event then
    warn("[Style Roller] Failed to find remotes - retrying in 2s")
    task.wait(2)
    Event, failRemote = getRemotes()
end

local FILE = "StyleRoller.json"

local cfg = {
    t  = "",
    on = false,
    x  = 0.5,
    y  = 0.5
}

local function load()
    pcall(function()
        if isfile and isfile(FILE) then
            local raw = readfile(FILE)
            if type(raw) == "string" and #raw > 2 then
                local ok, data = pcall(function()
                    return Http:JSONDecode(raw)
                end)
                if ok and type(data) == "table" then
                    cfg.t  = tostring(data.t or "")
                    cfg.on = (data.on == true)
                    cfg.x  = tonumber(data.x) or 0.5
                    cfg.y  = tonumber(data.y) or 0.5
                end
            end
        end
    end)
end

local function save()
    pcall(function()
        local payload = {
            t  = tostring(cfg.t or ""),
            on = (cfg.on == true),
            x  = tonumber(cfg.x) or 0.5,
            y  = tonumber(cfg.y) or 0.5
        }
        writefile(FILE, Http:JSONEncode(payload))
    end)
end

load()

